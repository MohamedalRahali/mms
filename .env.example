# Port du serveur MMS (API + site compilé)
MMS_PORT=8788
# Rapports de la veille radio : un dossier par jour contenant actualites.json
MOSAIQUE_DATA_DIR=../mosaique-radio/data
# Veille Libye : fichiers JSON déposés par le collecteur (format dans README.md)
LIBYE_DATA_DIR=./data/libye
# 1 = ajoute des actualités d'exemple (bandeau « données d'exemple » affiché)
MMS_DEMO=1

# Photos des actualités radio : pages du site où chercher l'article correspondant (séparées par des virgules)
MOSAIQUE_SITE=https://www.mosaiquefm.net/ar,https://www.mosaiquefm.net/fr

# Analyse intelligente : Claude si ANTHROPIC_API_KEY est présente, sinon Gemini (GEMINI_API_KEY), avec OpenAI (OPENAI_API_KEY) en secours.
# Si elles manquent ici, MMS reprend celles de ../mosaique-radio/.env ou ../veille-libye/.env
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MMS_GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# MMS_OPENAI_MODEL=gpt-4o-mini

# Alertes des veilles sur Telegram (en plus de l'e-mail) : jeton du bot créé avec @BotFather,
# et identifiant de la discussion ou du groupe (plusieurs, séparés par des virgules)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Console Super Admin (/superadmin) : ne rien écrire ici à la main, lancer sur le serveur
#   sudo -u mms node server/superadmin-setup.js   (demande l'identifiant et le mot de passe)
# qui ajoute SUPERADMIN_USER, SUPERADMIN_PASSWORD_HASH (haché) et SUPERADMIN_TOKEN_KEY.
# MMS_GEO=0 coupe la recherche du pays des adresses IP (ipwho.is).

# Radar intelligent : envoi automatique des alertes critiques (Telegram ci-dessus et/ou e-mail via SMTP_*),
# une seule fois chacune, vérifié toutes les 10 min. 1 = activé.
# MMS_RADAR_ALERTS=1
# MMS_RADAR_ALERTS_TO=cellule.veille@exemple.ly,direction@exemple.ly

# --- Moteurs d'IA sans réutilisation des données (audit v4, server/ai.js) ---
# Moteur principal / des tâches de fond forcé : claude | vertex | gemini | openai | local (vide = choix automatique)
# MMS_AI_PROVIDER=
# MMS_AI_ECONOMY_PROVIDER=
# Clé API Gemini FACTURÉE (projet Google Cloud avec facturation) : la déclarer, sinon elle est traitée comme gratuite
# MMS_GEMINI_TIER=paid
# Vertex AI (Gemini sur Google Cloud, offre payante) : projet + fichier JSON du compte de service (rôle « Vertex AI User »)
# MMS_VERTEX_PROJECT=mon-projet
# MMS_VERTEX_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=/opt/mms/vertex-sa.json
# MMS_VERTEX_MODEL=gemini-2.5-flash
# ou clé Vertex AI (mode express) : VERTEX_API_KEY=
# Modèle hébergé compatible OpenAI (Ollama, vLLM…)
# MMS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MMS_LLM_MODEL=qwen2.5:14b
# MMS_LLM_API_KEY=
# Claude pour les tâches de fond (modèle économique)
# MMS_CLAUDE_ECONOMY_MODEL=claude-haiku-5-5
# Garder Gemini gratuit en premier pour les tâches de fond (déconseillé) : MMS_AI_ALLOW_FREE=1

# --- Comptes (audit v4, server/accountPolicy.js) ---
# Comptes partagés désactivés dès qu'un admin nominatif connecté existe ; MMS_KEEP_SHARED=1 suspend la règle
# MMS_SHARED_ACCOUNTS=aroundexpressions@gmail.com
# MMS_NOMINATIVE_ADMIN=belgacem.ounissi@aroundexpressions.com,belgacem
# Plafond du budget de transcription réglable dans MMS ($ par jour) ; sauvegarde quotidienne de data/ (0 = arrêt)
# MMS_TRANSCRIPTION_MAX_JOUR=15
# MMS_BACKUPS=1
