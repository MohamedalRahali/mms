# Port du serveur MMS (API + site compilé)
MMS_PORT=8788
# Rapports de la veille radio : un dossier par jour contenant actualites.json
MOSAIQUE_DATA_DIR=../mosaique-radio/data
# Veille Libye : fichiers JSON déposés par le collecteur (format dans README.md)
LIBYE_DATA_DIR=./data/libye
# 1 = ajoute des actualités d'exemple (bandeau « données d'exemple » affiché)
MMS_DEMO=1

# Photos des actualités radio : pages du site où chercher l'article correspondant (séparées par des virgules)
MOSAIQUE_SITE=https://www.mosaiquefm.net/ar,https://www.mosaiquefm.net/fr

# Analyse intelligente : Claude si ANTHROPIC_API_KEY est présente, sinon Gemini (GEMINI_API_KEY), avec OpenAI (OPENAI_API_KEY) en secours.
# Si elles manquent ici, MMS reprend celles de ../mosaique-radio/.env ou ../veille-libye/.env
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MMS_GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# MMS_OPENAI_MODEL=gpt-4o-mini

# Alertes des veilles sur Telegram (en plus de l'e-mail) : jeton du bot créé avec @BotFather,
# et identifiant de la discussion ou du groupe (plusieurs, séparés par des virgules)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Console Super Admin (/superadmin) : ne rien écrire ici à la main, lancer sur le serveur
#   sudo -u mms node server/superadmin-setup.js   (demande l'identifiant et le mot de passe)
# qui ajoute SUPERADMIN_USER, SUPERADMIN_PASSWORD_HASH (haché) et SUPERADMIN_TOKEN_KEY.
# MMS_GEO=0 coupe la recherche du pays des adresses IP (ipwho.is).

# Radar intelligent : envoi automatique des alertes critiques (Telegram ci-dessus et/ou e-mail via SMTP_*),
# une seule fois chacune, vérifié toutes les 10 min. 1 = activé.
# MMS_RADAR_ALERTS=1
# MMS_RADAR_ALERTS_TO=cellule.veille@exemple.ly,direction@exemple.ly
