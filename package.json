{
  "name": "mms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:server": "node server/dev.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "start:prod": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "docx": "9.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hls.js": "1.7.3",
    "html2canvas-pro": "2.5.0",
    "jspdf": "4.2.1",
    "nodemailer": "^10.1.7",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
